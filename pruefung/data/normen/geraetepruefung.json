      "wiki": ["messverfahren-ableitstrom"],
      "defaultNext": "q-g-besonderheiten",
      "options": [
        { "id": "o-verf-ersatz", "label": "Ersatzableitstrom", "sub": "Gerät stromlos, Standardverfahren der Prüfgeräte", "set": { "ableitverfahren": "ersatz" }, "next": "q-g-besonderheiten" },
        { "id": "o-verf-differenz", "label": "Differenzstrom", "sub": "Gerät in Betrieb, erfasst auch Fehler über fremde Erde", "set": { "ableitverfahren": "differenz" }, "next": "q-g-besonderheiten" },
        { "id": "o-verf-direkt", "label": "Direktes Verfahren", "sub": "Gerät in Betrieb, Messung über Shunt", "set": { "ableitverfahren": "direkt" }, "next": "q-g-besonderheiten" }
      ]
    },

        { "id": "o-g-schweiss", "label": "Schweißgerät", "sub": "Zusätzlich DIN EN 60974-4", "when": { "world": "industrie" }, "set": { "schweissgeraet": "ja" }, "addTags": ["schweissen"] },
        { "id": "o-g-medizin", "label": "Medizinisches Gerät", "sub": "Andere Norm zuständig", "set": { "medizin": "ja" }, "next": "r-g-medizin" }

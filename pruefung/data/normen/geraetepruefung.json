      "defaultNext": "q-g-ableitverfahren",
      "options": [
        { "id": "o-g-handgeraet", "label": "Handgeführtes Gerät", "sub": "Bohrmaschine, Winkelschleifer, Föhn", "set": { "geraeteart": "handgeraet" }, "next": "q-g-ableitverfahren" },
        { "id": "o-g-standgeraet", "label": "Standgerät mit Stecker", "sub": "Kaffeemaschine, Werkstattgerät, Ständerbohrmaschine", "set": { "geraeteart": "standgeraet" }, "next": "q-g-ableitverfahren" },
        { "id": "o-g-leitung", "label": "Verlängerungs- oder Anschlussleitung", "sub": "Auch Kabeltrommel", "set": { "geraeteart": "leitung" }, "addTags": ["leitung"], "next": "q-g-leitungslaenge" },
        { "id": "o-g-mehrfach", "label": "Mehrfachsteckdose", "sub": "Steckdosenleiste, auch mit Schalter", "set": { "geraeteart": "mehrfachsteckdose" }, "addTags": ["leitung"], "next": "q-g-leitungslaenge" },
        { "id": "o-g-it", "label": "IT- oder Bürogerät", "sub": "Rechner, Netzteil, Monitor — hoher Schutzleiterstrom möglich", "set": { "geraeteart": "it" }, "addTags": ["it"], "next": "q-g-ableitverfahren" },
        { "id": "o-g-heiz", "label": "Heizgerät", "sub": "Heizlüfter, Kochplatte, Bautrockner", "set": { "geraeteart": "heizgeraet" }, "next": "q-g-heizleistung" }
      ]
    },
    {

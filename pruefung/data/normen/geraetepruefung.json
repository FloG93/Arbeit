        { "id": "o-heiz-gross", "label": "über 3,5 kW", "sub": "Grenzwert wird leistungsabhängig", "set": { "heizleistung": "ueber3_5kw", "isoFall": "heizgeraet" }, "next": "q-g-ableitverfahren" }
      ]
    },
    {
      "id": "q-g-ableitverfahren",
      "type": "question",
      "title": "Womit wird der Ableitstrom gemessen?",
      "help": "Alle drei Verfahren sind zulässig. Sie liefern aber nicht dieselben Werte — das Verfahren gehört deshalb ins Protokoll.",

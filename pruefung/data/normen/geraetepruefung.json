      "options": [
        { "id": "o-sk1", "label": "Schutzklasse I", "sub": "Schutzleiter am Stecker, Symbol ⏚", "set": { "schutzklasse": "sk1", "isoFall": "sk1", "beruehrungsstromNoetig": "nein" }, "next": "q-g-geraeteart" },
        { "id": "o-sk2", "label": "Schutzklasse II", "sub": "Schutzisoliert, Doppelquadrat-Symbol", "set": { "schutzklasse": "sk2", "isoFall": "sk2", "beruehrungsstromNoetig": "ja" }, "next": "q-g-geraeteart" },
        { "id": "o-sk3", "label": "Schutzklasse III", "sub": "Schutzkleinspannung SELV/PELV", "set": { "schutzklasse": "sk3", "isoFall": "sk3", "beruehrungsstromNoetig": "nein" }, "next": "q-g-geraeteart" }
      ]
    },
    {

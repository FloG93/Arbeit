        { "id": "o-len-lang", "label": "über 20 m", "sub": "Kabeltrommel, Baustellenleitung", "set": { "leitungslaenge": "ueber20" }, "next": "q-g-ableitverfahren" }
      ]
    },
    {
      "id": "q-g-heizleistung",
      "type": "question",
      "title": "Welche Heizleistung hat das Gerät?",
      "help": "Über 3,5 kW gilt für den Schutzleiterstrom nicht der feste Wert, sondern 1 mA je kW Heizleistung — höchstens 10 mA. Der Isolationswiderstand darf bei Heizgeräten kleiner sein.",
      "when": { "geraeteart": "heizgeraet" },
      "wiki": ["grenzwerte-geraet"],
      "defaultNext": "q-g-ableitverfahren",

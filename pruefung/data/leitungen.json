  "hinweise": [
    { "id": "nym-freien", "stufe": "warnung", "when": { "familie": "NYM", "ort": "freien" },
      "text": "NYM im Freien nur geschützt gegen direkte Sonne verlegen — der PVC-Mantel ist nicht UV-beständig. Für Außenwand und Carport besser NYY." },
    { "id": "nym-beton", "stufe": "warnung", "when": { "familie": "NYM", "ort": "beton" },
      "text": "NYM nicht direkt in Beton einbetten, der gerüttelt oder gestampft wird — nur im Leerrohr. Direkt einbetonieren: NYY." },
    { "id": "nyif-ort", "stufe": "warnung", "when": { "familie": "NYIF", "ort": ["freien", "beton"] },
      "text": "Stegleitung nur im oder unter Putz in trockenen Räumen." },
    { "id": "h07v-geschuetzt", "stufe": "info", "when": { "familie": "H07V" },
      "text": "Aderleitungen nur im geschlossenen Rohr, Kanal oder Gehäuse. Für den Schutzleiter eine eigene grün-gelbe Ader mitziehen." },
    { "id": "erde-rohr", "stufe": "info", "when": { "verlegeart": "D" },
      "text": "In Erde: Verlegetiefe, Sandbett und Warnband einhalten; an Hauseinführung und Übergängen mechanisch schützen." },
    { "id": "oberschwingungen", "stufe": "warnung", "when": { "osBasis": "N" },
      "text": "Mehr als ein Drittel 3. Oberschwingung: der Neutralleiter ist höher belastet als die Außenleiter. Die App bemisst deshalb nach dem N-Strom — Überlastschutz im N-Leiter mitdenken." },
    { "id": "wallbox-rcd", "stufe": "warnung", "when": { "vorlage": ["wallbox-11", "wallbox-22"] },
      "text": "Wallbox: eigener Stromkreis, RCD Typ A mit Gleichfehlerstrom-Erkennung 6 mA (in der Box) oder RCD Typ B. Anmeldung beim Netzbetreiber, ab 12 kW Zustimmung nötig." },
    { "id": "durchlauferhitzer", "stufe": "info", "when": { "vorlage": "durchlauferhitzer" },
      "text": "Durchlauferhitzer über 12 kW brauchen die Zustimmung des Netzbetreibers." },
    { "id": "tt-ohne-rcd", "stufe": "warnung", "when": { "netzform": "TT", "rcd": false },
      "text": "TT-System ohne RCD: die Abschaltbedingung hängt am Erdungswiderstand und ist mit einem Überstrom-Schutzorgan allein kaum erreichbar. Fehlerschutz über RCD vorsehen." },
    { "id": "rcd-kurzschluss", "stufe": "info", "when": { "rcd": true },
      "text": "Mit RCD als Fehlerschutz steht die Abschaltbedingung nur noch als Kurzschlussschutz (5 s) da. Die RCD-Auslösung selbst wird bei der Prüfung gemessen." },
    { "id": "ohne-vorimpedanz", "stufe": "info", "when": { "zvBekannt": false },
      "text": "Ohne Vorimpedanz rechnet die App zurück, welche Schleifenimpedanz am Verteiler höchstens vorliegen darf. Den Wert bei der Prüfung am Verteiler messen und vergleichen." }
  ],

